# ThinkTank Environment Configuration
# Copy this file to .env and adjust values as needed

# PostgreSQL
POSTGRES_USER=thinktank
POSTGRES_PASSWORD=thinktank_dev
POSTGRES_DB=thinktank
POSTGRES_PORT=5432
DATABASE_URL=postgresql://thinktank:thinktank_dev@localhost:5432/thinktank

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=thinktank
MINIO_ROOT_PASSWORD=thinktank_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=thinktank-assets

# Meilisearch
MEILI_ENV=development
MEILI_MASTER_KEY=thinktank_search_dev
MEILI_PORT=7700
MEILI_URL=http://localhost:7700

# Application
NODE_ENV=development
PORT=3000
API_PORT=3001

# Auth (generate secure secrets for production)
JWT_SECRET=change_this_to_a_secure_random_string_in_production
SESSION_SECRET=change_this_to_another_secure_random_string

# AI (optional - configure based on your preferred provider)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
